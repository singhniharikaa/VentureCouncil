# Copy this file to .env and fill in the real values.
# .env is gitignored and must never be committed.

# Which LLM the agents talk to: groq | gemini | grok
# groq is the pinned provider - free tier, 1000 requests/day.
# NOTE: groq (Groq Cloud, key prefix gsk_) is NOT grok (xAI, key prefix xai-).
LLM_PROVIDER=groq

# Needed when LLM_PROVIDER=gemini -- https://aistudio.google.com/apikey
# Free tier: 20 requests/day and 5/minute per model (50/day, 15/min on lite).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Needed when LLM_PROVIDER=groq -- https://console.groq.com/keys
# Free tier: 1,000 requests/day, 8,000 tokens/minute.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Needed when LLM_PROVIDER=grok -- https://console.x.ai  (untested, no key)
GROK_API_KEY=
GROK_MODEL=grok-4.3

# Max simultaneous LLM calls. The graph fans out to 4 agents at once.
# Use 2 on Gemini free tier to stay under 5 requests/minute.
LLM_MAX_CONCURRENCY=4

# REQUIRED. Supabase > Project Settings > Database > Connection string >
# Transaction pooler (port 6543). Contains a password -- never commit the real value.
SUPABASE_CONN_STRING=
